<Window x:Class="VideoToGifConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoToGifConverter.Desktop"
        mc:Ignorable="d"
        Title="Video to GIF Converter" Height="450" Width="800">
    <Grid>
        <StackPanel>

            <TextBlock
            Text="Selected video:"
            FontWeight="Bold"/>

            <TextBlock
            Name="SelectedVideoText"
            Margin="0,5,0,20"
            Text="No video selected."/>

            <Button
            Name="SelectVideoButton"
            Width="160"
            Height="40"
            Content="Select Video"
            Click="SelectVideoButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
