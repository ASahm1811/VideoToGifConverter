<Window x:Class="VideoToGifConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video to GIF Converter"
        Height="400"
        Width="500">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                Text="Selected video:"
                FontWeight="Bold"/>

            <TextBlock
                x:Name="SelectedVideoText"
                Margin="0,5,0,20"
                Text="No video selected."
                TextWrapping="Wrap"/>

            <Button
                x:Name="SelectVideoButton"
                Width="160"
                Height="40"
                Content="Select Video"
                Click="SelectVideoButton_Click"/>

            <Grid Margin="0,15,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="FPS:"
                    VerticalAlignment="Center"/>

                <ComboBox
                    x:Name="FpsComboBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="120"
                    SelectedIndex="2">

                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="30"/>

                </ComboBox>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Width:"
                    Margin="0,10,0,0"
                    VerticalAlignment="Center"/>

                <TextBox
                    x:Name="WidthTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="120"
                    Margin="0,10,0,0"
                    Text="480"/>

            </Grid>

            <Button
                x:Name="ConvertButton"
                Content="Convert"
                Width="160"
                Height="40"
                Margin="0,20,0,0"
                Click="Convert_Click"/>

            <Grid
                x:Name="ProgressPanel"
                Margin="0,10,0,0"
                Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="ConversionProgressBar"
                    Grid.Column="0"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Height="15"
                    IsIndeterminate="False" />

                <TextBlock
                    x:Name="ProgressPercentageText"
                    Grid.Column="1"
                    Text="0%"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />

            </Grid>

            <TextBlock
                x:Name="StatusText"
                Text="Select a video to get started."
                Margin="0,10,0,0"
                TextWrapping="Wrap"/>

            <Button
                x:Name="CancelButton"
                Content="Cancel"
                Width="160"
                Height="40"
                Margin="0,10,0,0"
                IsEnabled="False"
                Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>

</Window>