<Window x:Class="VideoToGifConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video to GIF Converter"
        Height="400"
        Width="500">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                Text="Selected video:"
                FontWeight="Bold"/>

            <TextBlock
                x:Name="SelectedVideoText"
                Margin="0,5,0,20"
                Text="No video selected."/>

            <Button
                x:Name="SelectVideoButton"
                Width="160"
                Height="40"
                Content="Select Video"
                Click="SelectVideoButton_Click"/>

            <StackPanel
                Orientation="Horizontal"
                Margin="0,10,0,0">

                <TextBlock
                    Text="FPS:"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>

                <ComboBox
                    x:Name="FpsComboBox"
                    Width="100"
                    SelectedIndex="5">

                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="30"/>

                </ComboBox>

            </StackPanel>

            <StackPanel
            Orientation="Horizontal"
            Margin="0,10,0,0">

            <TextBlock
            Text="Width:"
            VerticalAlignment="Center"
            Margin="0,0,10,0"/>

            <TextBox
            x:Name="WidthTextBox"
            Width="100"
            Text="1920"/>

            </StackPanel>

            <Button
                x:Name="ConvertButton"
                Content="Convert"
                Width="100"
                Margin="0,10,0,0"
                Click="Convert_Click"/>

            <ProgressBar
                x:Name="ConversionProgressBar"
                Minimum="0"
                Maximum="100"
                Value="0"
                IsIndeterminate="False"
                Visibility="Collapsed" />

        </StackPanel>

    </Grid>

</Window>